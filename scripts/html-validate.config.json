{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "element-required-attributes": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "wcag/h36": "off",
    "wcag/h37": "warn",
    "wcag/h63": "warn",
    "wcag/h67": "off",
    "wcag/h71": "off",
    "no-implicit-button-type": "warn",
    "require-sri": "off",
    "long-title": "off",
    "attribute-allowed-values": "warn",
    "no-dup-id": "error",
    "unique-landmark": "off",
    "input-missing-label": "warn"
  }
}
